# Copy to .env.local and fill in. Never commit .env.local.

# Google Gemini (aistudio.google.com -> Get API key)
GEMINI_API_KEY=
# Optional overrides
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FAST_MODEL=gemini-flash-lite-latest
# GEMINI_PREFER_FLASH=true

# Supabase (Project Settings -> API). URL is the base URL only, no /rest/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to hash Aadhaar numbers (any long random string; never change after go-live)
AADHAAR_SALT=

# Dispute window before a reported violation lowers a score. Production: 4320 (3 days). Demo: 2
DISPUTE_WINDOW_MINUTES=4320

# Twilio WhatsApp (sandbox for the MVP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SANDBOX_JOIN=join your-sandbox-code
